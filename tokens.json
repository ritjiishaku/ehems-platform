    "type-tracking-body-small": "0.033em",
    "type-tracking-label-large": "0.007em",
    "type-tracking-label-medium": "0.042em",
    "type-tracking-label-small": "0.045em",

    "$roles": "The 15 Material Design 3 type roles are the combination of the four key families above: type-size-<role> + type-line-height-<role> + a type-weight-* + type-tracking-<role>. They are deliberately NOT emitted as composite font shorthands - build-tokens.js resolves only whole-string {references}, so a shorthand would ship unresolved braces. styles/type.css binds each role to one @utility that var()-references its four parts, so a role cannot be spelled with a mismatched part. Sizes are the MD3 values in rem (57/45/36/32/28/24/22/16/14/16/14/12/14/12/11px). Line heights are MD3's px ratios expressed unitless so they scale with a user's font-size setting - MD3's px line-heights do not. Tracking is MD3's px tracking expressed in em. Weights are 400 and 500 only, because that is all MD3 uses; font-weight-* above is retained for brand use outside the role system. Montserrat has a larger x-height than the Roboto the MD3 ratios were derived from, so these line heights are Montserrat-adjusted and should be revisited once ASM-001 delivers the brand pack."
  },
  "motion": {
    "$description": "Motion tokens. Referenced by docs/implementation-plan.md as --motion-fast; that reference previously had no backing token. Every duration must be driven to zero under prefers-reduced-motion - the guard lives in styles/type.css and any future stylesheet, never per component.",
    "motion-duration-instant": "0ms",
    "motion-duration-fast": "150ms",
    "motion-duration-medium": "250ms",
    "motion-duration-slow": "400ms",
    "motion-easing-standard": "cubic-bezier(0.2, 0, 0, 1)",
    "motion-easing-emphasized": "cubic-bezier(0.05, 0.7, 0.1, 1)"
  },
