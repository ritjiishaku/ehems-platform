{
  "$description": "EHEMS design tokens. Colour is split in two: color.palette holds primitive tones, color.role holds the semantic roles the UI is allowed to use. Roles reference primitives with {color.palette.*} references, resolved at build time by scripts/build-tokens.js. Values marked provisional are placeholders pending ASM-001 (client brand assets).",
  "color": {
    "$description": "Primitives are never emitted to CSS. Only roles are.",
    "palette": {
      "$description": "Provisional brand tones. Replace with the ASM-001 hex codes; roles do not need to change.",
      "navy": {
        "$description": "Primary hue. Provisional.",
        "100": "hsl(225, 100%, 92%)",
        "200": "hsl(223, 72%, 83%)",
        "700": "hsl(221, 35%, 31%)",
        "900": "hsl(218, 74%, 15%)"
      },
      "amber": {
        "$description": "Secondary hue. Provisional.",
        "200": "hsl(38, 100%, 82%)",
        "400": "hsl(43, 98%, 54%)",
        "700": "hsl(43, 100%, 24%)",
        "800": "hsl(43, 100%, 18%)",
        "900": "hsl(42, 100%, 13%)"
      },
      "plum": {
        "$description": "Tertiary hue. Provisional.",
        "100": "hsl(293, 100%, 92%)",
        "200": "hsl(287, 95%, 84%)",
        "600": "hsl(286, 31%, 42%)",
        "700": "hsl(285, 40%, 33%)",
        "900": "hsl(284, 56%, 23%)"
      },
      "red": {
        "$description": "Error hue. Deepened away from pink: 50/100 are desaturated and cooler, 600 is the primary action and text role in light, 300 is its dark-theme counterpart. Provisional.",
        "50": "hsl(0, 80%, 94%)",
        "100": "hsl(0, 76%, 88%)",
        "300": "hsl(0, 62%, 72%)",
        "500": "hsl(0, 68%, 40%)",
        "600": "hsl(0, 68%, 36%)",
        "700": "hsl(0, 68%, 24%)",
        "850": "hsl(0, 32%, 22%)",
        "900": "hsl(0, 84%, 15%)"
      },
      "neutral": {
        "$description": "Surfaces, text and outlines for both themes. Light text uses 1000, dark surfaces use 1000-1025.",
        "0": "hsl(48, 11%, 100%)",
        "50": "hsl(48, 11%, 98%)",
        "100": "hsl(48, 11%, 96%)",
        "200": "hsl(48, 10%, 93%)",
        "300": "hsl(48, 10%, 91%)",
        "400": "hsl(48, 11%, 89%)",
        "500": "hsl(48, 11%, 85%)",
        "600": "hsl(48, 11%, 72%)",
        "700": "hsl(48, 11%, 58%)",
        "800": "hsl(48, 11%, 45%)",
        "900": "hsl(48, 11%, 28%)",
        "950": "hsl(48, 11%, 20%)",
        "975": "hsl(48, 11%, 15%)",
        "1000": "hsl(48, 11%, 11%)",
        "1025": "hsl(48, 11%, 7%)"
      },
      "cream": {
        "$description": "Surface-variant family. Warmer and more saturated than neutral in light, muted in dark.",
        "50": "hsl(46, 30%, 90%)",
        "100": "hsl(46, 41%, 85%)",
        "800": "hsl(51, 16%, 25%)",
        "900": "hsl(46, 20%, 24%)"
      }
    },
    "role": {
      "light": {
        "$description": "Light theme roles.",
        "primary-color": "{color.palette.navy.900}",
        "on-primary-color": "{color.palette.neutral.0}",
        "primary-container-color": "{color.palette.navy.200}",
        "on-primary-container-color": "{color.palette.navy.700}",
        "secondary-color": "{color.palette.amber.700}",
        "on-secondary-color": "{color.palette.neutral.0}",
        "secondary-container-color": "{color.palette.amber.400}",
        "on-secondary-container-color": "{color.palette.amber.900}",
        "tertiary-color": "{color.palette.plum.600}",
        "on-tertiary-color": "{color.palette.neutral.0}",
        "tertiary-container-color": "{color.palette.plum.200}",
        "on-tertiary-container-color": "{color.palette.plum.700}",
        "error-color": "{color.palette.red.600}",
        "on-error-color": "{color.palette.neutral.0}",
        "error-container-color": "{color.palette.red.50}",
        "on-error-container-color": "{color.palette.red.700}",
        "background-color": "{color.palette.neutral.50}",
        "on-background-color": "{color.palette.neutral.1000}",
        "surface-color": "{color.palette.neutral.50}",
        "on-surface-color": "{color.palette.neutral.1000}",
        "surface-variant-color": "{color.palette.cream.100}",
        "on-surface-variant-color": "{color.palette.cream.800}",
        "outline-color": "{color.palette.neutral.800}",
        "outline-variant-color": "{color.palette.neutral.600}",
        "inverse-surface-color": "{color.palette.neutral.950}",
        "inverse-on-surface-color": "{color.palette.neutral.50}",
        "inverse-primary-color": "{color.palette.navy.200}",
        "surface-dim-color": "{color.palette.neutral.500}",
        "surface-bright-color": "{color.palette.neutral.50}",
        "surface-container-lowest-color": "{color.palette.neutral.0}",
        "surface-container-low-color": "{color.palette.neutral.100}",
        "surface-container-color": "{color.palette.neutral.200}",
        "surface-container-high-color": "{color.palette.neutral.300}",
        "surface-container-highest-color": "{color.palette.neutral.400}"
      },
      "dark": {
        "$description": "Dark theme roles. The surface ladder spans neutral 1000-1025 so on-surface clears 4.5:1 on every surface, and outline sits at 700 to clear 3:1 on the brightest one.",
        "primary-color": "{color.palette.navy.200}",
        "on-primary-color": "{color.palette.navy.900}",
        "primary-container-color": "{color.palette.navy.700}",
        "on-primary-container-color": "{color.palette.navy.100}",
        "secondary-color": "{color.palette.amber.400}",
        "on-secondary-color": "{color.palette.amber.900}",
        "secondary-container-color": "{color.palette.amber.800}",
        "on-secondary-container-color": "{color.palette.amber.200}",
        "tertiary-color": "{color.palette.plum.200}",
        "on-tertiary-color": "{color.palette.plum.900}",
        "tertiary-container-color": "{color.palette.plum.700}",
        "on-tertiary-container-color": "{color.palette.plum.100}",
        "error-color": "{color.palette.red.300}",
        "on-error-color": "{color.palette.red.900}",
        "error-container-color": "{color.palette.red.850}",
        "on-error-container-color": "{color.palette.red.50}",
        "background-color": "{color.palette.neutral.1000}",
        "on-background-color": "{color.palette.neutral.50}",
        "surface-color": "{color.palette.neutral.1000}",
        "on-surface-color": "{color.palette.neutral.50}",
        "surface-variant-color": "{color.palette.cream.900}",
        "on-surface-variant-color": "{color.palette.cream.50}",
        "outline-color": "{color.palette.neutral.700}",
        "outline-variant-color": "{color.palette.neutral.900}",
        "inverse-surface-color": "{color.palette.neutral.100}",
        "inverse-on-surface-color": "{color.palette.neutral.900}",
        "inverse-primary-color": "{color.palette.navy.700}",
        "surface-dim-color": "{color.palette.neutral.1025}",
        "surface-bright-color": "{color.palette.neutral.900}",
        "surface-container-lowest-color": "{color.palette.neutral.1025}",
        "surface-container-low-color": "{color.palette.neutral.1000}",
        "surface-container-color": "{color.palette.neutral.975}",
        "surface-container-high-color": "{color.palette.neutral.950}",
        "surface-container-highest-color": "{color.palette.neutral.900}"
      }
    }
  },
