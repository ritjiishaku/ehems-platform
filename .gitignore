.env
.env.*
!.env.example

# vercel CLI project link. Machine-local metadata (project id, org id) written by
# `vercel link`. It is not a secret, but it is per-checkout state: committing it
# makes a clone on another machine look linked to this project, and it has no
# business in the repository.
/.vercel/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# encrypted payment proofs (SEC-004). These are member financial documents. The
# default `PAYMENT_PROOF_STORAGE_DIR` is `.storage/proof` inside the project, so
# without this a local test upload would be committable. Production must point
# the env var at a mounted volume outside the project directory — see
# next.config.ts outputFileTracingExcludes for why bundling this is a problem.
/.storage/

# typescript
*.tsbuildinfo
next-env.d.ts

# one-off schema scripting. `prisma/schema.prisma` is the source of truth and
# every change to it belongs in a reviewed Prisma migration, so these
# text-splicing helpers are scaffolding, not build inputs.
/generate_schema.py
/patch_schema.py
