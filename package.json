{
  "name": "ehems-platform",
  "version": "0.1.0",
  "private": true,
  "description": "EHEMS platform - design token pipeline and Next.js app",
  "scripts": {
    "build:tokens": "node scripts/build-tokens.js",
    "check:tokens": "node scripts/build-tokens.js --check",
    "test:tokens": "node --test test/*.test.js",
    "test:app": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test": "npm run test:tokens && npm run test:app",
    "test:e2e": "playwright test",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write app components lib styles test",
    "format:check": "prettier --check app components lib styles test",
    "verify": "npm run check:tokens && npm run typecheck && npm run lint && npm run format:check && npm run test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node -P prisma/tsconfig.seed.json prisma/seed.ts",
    "db:seed:test-payments": "ts-node -P prisma/tsconfig.seed.json prisma/seeds/test-payments.ts",
    "db:create-admin": "ts-node -P prisma/tsconfig.seed.json scripts/create-admin.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.0",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^28",
    "prettier": "^3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^5",
    "vitest-axe": "^0.1.0"
  },
  "prisma": {
    "seed": "npm run db:seed"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true,
    "argon2": true,
    "unrs-resolver": true
  }
}
