// =============================================================================
// EHEMS Platform — Prisma Schema (Phase 2A + decision-dependent domain models)
//
// The current schema contains the approved domain structures as well as
// decision-dependent models. Client decisions are recorded in
// docs/decisions.md; schema presence does not mean the feature workflow is
// implemented.
//
//   D-3 / D-12 → five assignable roles; authorization rejects legacy role keys
//   D-4         → EnrolmentProgramme many-to-many (modeled below)
//   D-5         → 27 certificates approved; catalogue currently has 26 names
//   D-6         → Material attached to Programme (modeled below)
//   D-1 / D-8  → free-tier exception/resubmission decided; the Payment model and
//                  the manual verification workflow are modeled below
//
// Conventions (AGENTS.md §7):
//   - All field names snake_case via @map; relation names camelCase in code
//   - Money is Int kobo; dates are stored UTC
//   - Every model has an explicit @@map for the SQL table name
//   - Every relation has a named back-reference on BOTH sides
//   - Soft-delete via deleted_at; personal data has data_retention_until
//   - AuditLog is append-only — a DB trigger enforces this (see migration)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------
// Soft-deleted via deleted_at. data_retention_until anchors erasure to a
// fixed date (never "N days from last activity") per SEC-016 and Phase 2A
// guidance in docs/implementation-plan.md.
//
// phone remains nullable for legacy rows; registration now requires a
// normalized Nigerian number. Nigerian format is enforced in lib/validation/.
// ---------------------------------------------------------------------------
model User {
  id                     String    @id @default(cuid()) @map("id")
  email                  String    @unique @map("email")
  name                   String    @map("name")
  phone                  String?   @map("phone")
  profession             String?   @map("profession")
  healthcareSpecialty    String?   @map("healthcare_specialty")
  passwordHash           String    @map("password_hash")
  passwordResetTokenHash String?   @unique @map("password_reset_token_hash")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")
  // FK to Role (Phase 2B) � the single authoritative "current role" the session reads.
  // Nullable because a user with no role holds NO permissions.
  roleId                 String?   @map("role_id")
  deletedAt              DateTime? @map("deleted_at")
  dataRetentionUntil     DateTime? @map("data_retention_until")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  sessions                   Session[]
  consentRecords             ConsentRecord[]
  dataSubjectRequests        DataSubjectRequest[]
  dataSubjectRequestsHandled DataSubjectRequest[] @relation("DataSubjectRequestHandledBy")
  notifications              Notification[]
  actorAuditLogs             AuditLog[]           @relation("AuditLogActor")
  roleRef                    Role?                @relation("UserCurrentRole", fields: [roleId], references: [id], onDelete: SetNull)
  userRoles                  UserRole[]
  enrolments                 Enrolment[]
  attendanceRecords          AttendanceRecord[]
  certificates               MemberCertificate[]
  payments                   Payment[]            @relation("PaymentUser")
  paymentsOpened             Payment[]            @relation("PaymentOpenedBy")
  paymentsVerified           Payment[]            @relation("PaymentVerifiedBy")

  @@index([email])
  @@index([deletedAt])
  @@index([roleId])
  @@map("user")
}

// ---------------------------------------------------------------------------
// Session
// ---------------------------------------------------------------------------
// Replaces the in-memory USERS Map in lib/auth.ts. The session cookie stores
// the session ID; tokenHash stores a SHA-256 of the random token so the raw
// token never touches the DB. Rotating the session on login and privilege
// change: delete old row, insert new.
//
// expiresAt is refreshed on activity using the role-specific inactivity window;
// absoluteExpiresAt caps sessions at the client-confirmed 30 days (D-14).
// ---------------------------------------------------------------------------
model Session {
  id                String   @id @default(cuid()) @map("id")
  userId            String   @map("user_id")
  tokenHash         String   @unique @map("token_hash")
  createdAt         DateTime @default(now()) @map("created_at")
  expiresAt         DateTime @map("expires_at")
  absoluteExpiresAt DateTime @map("absolute_expires_at")
  ipAddress         String?  @map("ip_address")
  userAgent         String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("session")
}

// Shared, short-window auth throttling. Keys are HMAC digests, not raw email/IP.
model AuthRateLimitBucket {
  keyHash   String     @id @map("key_hash")
  attempts  DateTime[] @default([]) @map("attempts")
  expiresAt DateTime   @map("expires_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("auth_rate_limit_bucket")
}

// ---------------------------------------------------------------------------
// ConsentRecord  (SEC-011, SEC-012)
// ---------------------------------------------------------------------------
// Captured at registration with version, text, timestamp, IP, and user agent.
// withdrawnAt is set on withdrawal — the row is NEVER deleted.
// A new row is inserted whenever consent is re-granted after withdrawal.
// ---------------------------------------------------------------------------
enum ConsentType {
  data_processing
  marketing
  sensitive_data
  cross_border_transfer

  @@map("consent_type")
}

model ConsentRecord {
  id             String      @id @default(cuid()) @map("id")
  userId         String      @map("user_id")
  consentType    ConsentType @default(data_processing) @map("consent_type")
  consentVersion String      @map("consent_version")
  consentText    String      @map("consent_text")
  capturedAt     DateTime    @default(now()) @map("captured_at")
  ipAddress      String?     @map("ip_address")
  userAgent      String?     @map("user_agent")
  withdrawnAt    DateTime?   @map("withdrawn_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([withdrawnAt])
  @@map("consent_record")
}

// ---------------------------------------------------------------------------
// AuditLog  (SEC-007, SEC-015)
// ---------------------------------------------------------------------------
// Append-only. The migration adds a trigger that REJECTs UPDATE and DELETE,
// and the application role has TRUNCATE revoked. No UPDATE or DELETE on this
// table — ever.
//
// Reading the audit log is itself an audited action: the read is recorded by
// the caller before displaying results.
// ---------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(cuid()) @map("id")
  action     String   @map("action")
  actorId    String?  @map("actor_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?    @map("metadata")
  createdAt  DateTime @default(now()) @map("created_at")

  // `onDelete: Restrict`, not SetNull. SEC-015 makes the audit trail immutable
  // and the append-only trigger blocks the UPDATE that SetNull would need, so a
  // SetNull FK declared a cascade the database can never perform. Restrict says
  // what is true: a user with audit history is not hard-deletable, and erasure
  // goes through anonymisation instead (AGENTS.md section 3).
  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// DataSubjectRequest  (SEC-013)
// ---------------------------------------------------------------------------
// First-class record for NDPA data-subject rights: access, rectification,
// erasure, restriction, portability, objection.
// requestType uses a plain String; lib/validation/ enforces the enum values.
// ---------------------------------------------------------------------------
model DataSubjectRequest {
  id            String    @id @default(cuid()) @map("id")
  userId        String    @map("user_id")
  requestType   String    @map("request_type")
  status        String    @default("pending") @map("status")
  handlingNotes String?   @map("handling_notes")
  // PRD §16.1 `handled_by` — the staff member who owns the request. A row
  // trigger cannot carry attribution, so it is written by the transition in
  // lib/ndpa/data-subject-requests.ts alongside the audit entry.
  handledBy     String?   @map("handled_by")
  resolvedAt    DateTime? @map("resolved_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  handledByUser User? @relation("DataSubjectRequestHandledBy", fields: [handledBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([handledBy])
  @@map("data_subject_request")
}

// ---------------------------------------------------------------------------
// BreachIncident  (SEC-014)
// ---------------------------------------------------------------------------
// The 72-hour NDPC notification window is tracked explicitly via
// ndpcNotifiedAt. The application computes the window from detectedAt.
// ---------------------------------------------------------------------------
model BreachIncident {
  id             String    @id @default(cuid()) @map("id")
  detectedAt     DateTime  @map("detected_at")
  affectedCount  Int       @map("affected_count")
  riskLevel      String    @map("risk_level")
  description    String    @map("description")
  ndpcNotifiedAt DateTime? @map("ndpc_notified_at")
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([detectedAt])
  @@map("breach_incident")
}

// ---------------------------------------------------------------------------
// Notification
// ---------------------------------------------------------------------------
// Channel-agnostic log. Every sent notification lands here regardless of
// channel. lib/notifications/ is the only code that writes to this table.
// payload holds template variables. failedAt + failureReason support retry
// logic without a separate table.
// ---------------------------------------------------------------------------
model Notification {
  id            String    @id @default(cuid()) @map("id")
  userId        String?   @map("user_id")
  channel       String    @map("channel")
  template      String    @map("template")
  payload       Json?     @map("payload")
  sentAt        DateTime? @map("sent_at")
  failedAt      DateTime? @map("failed_at")
  failureReason String?   @map("failure_reason")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([channel, sentAt])
  @@map("notification")
}

// ---------------------------------------------------------------------------
// CommunityLink  (BR-011, BR-012, AGENTS.md §3)
// ---------------------------------------------------------------------------
// Community links are DATA, not code. Never hardcode a WhatsApp or Telegram
// URL. accessLevel is "general" (all tiers including O'Free) or
// "ehems_open_sales" (Advanced IV+).
// tierName is nullable: null means the link applies to all tiers.
// ---------------------------------------------------------------------------
model CommunityLink {
  id          String   @id @default(cuid()) @map("id")
  name        String   @map("name")
  url         String   @map("url")
  accessLevel String   @map("access_level")
  tierName    String?  @map("tier_name")
  active      Boolean  @default(true) @map("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([accessLevel, active])
  @@map("community_link")
}

// ---------------------------------------------------------------------------
// Product
// ---------------------------------------------------------------------------
// Physical and digital products. productType uses a String; lib/validation/
// enforces the enum values (D-10 build-around — read from enum, not count).
// priceKobo: Int. Top tier ₦1,250,000 = 125,000,000 kobo; Int32 tops at
// 2,147,483,647 so even a ₦21M product fits. (See Phase 2A plan note.)
// ---------------------------------------------------------------------------
model Product {
  id          String   @id @default(cuid()) @map("id")
  name        String   @map("name")
  description String?  @map("description")
  productType String   @map("product_type")
  priceKobo   Int      @map("price_kobo")
  currency    String   @default("NGN") @map("currency")
  active      Boolean  @default(true) @map("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@index([active])
  @@map("product")
}

// ---------------------------------------------------------------------------
// Order
// ---------------------------------------------------------------------------
// Records a member's product purchase intent. status: "pending" | "confirmed"
// | "cancelled". Related to Product via OrderItem join.
// ---------------------------------------------------------------------------
model Order {
  id        String   @id @default(cuid()) @map("id")
  userId    String   @map("user_id")
  productId String   @map("product_id")
  totalKobo Int      @map("total_kobo")
  currency  String   @default("NGN") @map("currency")
  status    String   @default("pending") @map("status")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([productId])
  @@map("order")
}

// ---------------------------------------------------------------------------
// FeedbackForm + FeedbackResponse
// ---------------------------------------------------------------------------
// Admins create forms; members submit responses. Feedback analytics is Phase
// 2 (AGENTS.md §9 out-of-scope fence); this is the storage layer only.
// ---------------------------------------------------------------------------
model FeedbackForm {
  id          String   @id @default(cuid()) @map("id")
  title       String   @map("title")
  description String?  @map("description")
  active      Boolean  @default(true) @map("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  responses FeedbackResponse[]

  @@map("feedback_form")
}

model FeedbackResponse {
  id           String   @id @default(cuid()) @map("id")
  formId       String   @map("form_id")
  userId       String?  @map("user_id")
  responseData Json     @map("response_data")
  submittedAt  DateTime @default(now()) @map("submitted_at")

  form FeedbackForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([userId])
  @@map("feedback_response")
}

// ---------------------------------------------------------------------------
// SystemSetting
// ---------------------------------------------------------------------------
// Key/value config. Admins can change settings without a code deploy.
// ---------------------------------------------------------------------------
model SystemSetting {
  key         String   @id @map("key")
  value       String   @map("value")
  description String?  @map("description")
  // A string rather than a User FK because bootstrap and seed changes may run
  // without a user row. Admin UI changes use the authenticated user id; seed
  // changes use a stable source label such as `seed:test-payments`.
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_setting")
}

// ---------------------------------------------------------------------------
// RetentionPolicy  (SEC-016)
// ---------------------------------------------------------------------------
// Per data-category retention. expiryDays is anchored to a fixed duration
// from the record's creation, never from last activity — otherwise an erasure
// request can be indefinitely defeated.
// ---------------------------------------------------------------------------
model RetentionPolicy {
  id          String   @id @default(cuid()) @map("id")
  category    String   @unique @map("category")
  expiryDays  Int      @map("expiry_days")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("retention_policy")
}

// ---------------------------------------------------------------------------
// Programme + ProgrammeSession
// ---------------------------------------------------------------------------
// The uncontroversial parts of the programme model. The tier relationship
// (ProgrammeTier many-to-many) and Enrolment.programme_id are blocked on D-4
// and land in Phase 2B.
//
// attendanceThreshold defaults to 60 (BR-008) and is snapshotted onto each
// enrolment at activation so a later CMS edit cannot retroactively change
// whether someone qualified (Phase 10 note in implementation-plan.md).
// ---------------------------------------------------------------------------
model Programme {
  id                  String   @id @default(cuid()) @map("id")
  name                String   @map("name")
  description         String?  @map("description")
  attendanceThreshold Int      @default(60) @map("attendance_threshold")
  active              Boolean  @default(true) @map("active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  sessions   ProgrammeSession[]
  enrolments EnrolmentProgramme[]
  materials  Material[]
  tiers      ProgrammeTier[]

  @@map("programme")
}

model ProgrammeSession {
  id          String    @id @default(cuid()) @map("id")
  programmeId String    @map("programme_id")
  title       String    @map("title")
  description String?   @map("description")
  startsAt    DateTime  @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  programme         Programme          @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]

  @@index([programmeId])
  @@index([startsAt])
  @@map("programme_session")
}

// ---------------------------------------------------------------------------
// Role & UserRole (D-3, D-12)
// ---------------------------------------------------------------------------
model Role {
  id          String  @id @default(cuid()) @map("id")
  name        String  @unique @map("name")
  label       String  @map("label")
  description String? @map("description")
  isSystem    Boolean @default(true) @map("is_system")

  currentUsers User[]     @relation("UserCurrentRole")
  users        UserRole[]

  @@map("role")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedBy])
  @@map("user_role")
}

// ---------------------------------------------------------------------------
// Tier & Benefits
// ---------------------------------------------------------------------------
model Tier {
  id                       String   @id @default(cuid()) @map("id")
  name                     String   @unique @map("name")
  displayOrder             Int      @map("display_order")
  priceKobo                Int      @map("price_kobo")
  currency                 String   @default("NGN") @map("currency")
  mentorshipDurationMonths Int      @map("mentorship_duration_months")
  positioningText          String?  @map("positioning_text")
  isFree                   Boolean  @default(false) @map("is_free")
  active                   Boolean  @default(true) @map("active")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  benefits     TierBenefit[]
  certificates TierCertificate[]
  enrolments   Enrolment[]
  programmes   ProgrammeTier[]

  @@map("tier")
}

model TierBenefit {
  id           String @id @default(cuid()) @map("id")
  tierId       String @map("tier_id")
  benefitText  String @map("benefit_text")
  category     String @map("category")
  displayOrder Int    @map("display_order")

  tier Tier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@index([tierId])
  @@map("tier_benefit")
}

model ProgrammeTier {
  programmeId String @map("programme_id")
  tierId      String @map("tier_id")

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  tier      Tier      @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@id([programmeId, tierId])
  @@map("programme_tier")
}

// ---------------------------------------------------------------------------
// Certificates (Catalogue & Member)
// ---------------------------------------------------------------------------
model CertificateCatalogue {
  id          String  @id @default(cuid()) @map("id")
  name        String  @unique @map("name")
  description String? @map("description")
  templateUrl String? @map("template_url")
  issuingBody String  @default("EHEMS") @map("issuing_body")
  active      Boolean @default(true) @map("active")

  tiers  TierCertificate[]
  issued MemberCertificate[]

  @@map("certificate_catalogue")
}

model TierCertificate {
  tierId        String @map("tier_id")
  certificateId String @map("certificate_id")

  tier        Tier                 @relation(fields: [tierId], references: [id], onDelete: Cascade)
  certificate CertificateCatalogue @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@id([tierId, certificateId])
  @@map("tier_certificate")
}

model MemberCertificate {
  id             String   @id @default(cuid()) @map("id")
  userId         String   @map("user_id")
  certificateId  String   @map("certificate_id")
  enrolmentId    String   @map("enrolment_id")
  issuedAt       DateTime @default(now()) @map("issued_at")
  issuedBy       String?  @map("issued_by")
  verificationId String   @unique @map("verification_id")
  status         String   @default("active") @map("status")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  certificate CertificateCatalogue @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  enrolment   Enrolment            @relation(fields: [enrolmentId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([enrolmentId])
  @@map("member_certificate")
}

// ---------------------------------------------------------------------------
// Enrolment & Attendance
// ---------------------------------------------------------------------------
model Enrolment {
  id                           String    @id @default(cuid()) @map("id")
  userId                       String    @map("user_id")
  tierId                       String    @map("tier_id")
  status                       String    @default("pending_payment") @map("status")
  enrolledAt                   DateTime  @default(now()) @map("enrolled_at")
  completedAt                  DateTime? @map("completed_at")
  completionMarkedBy           String?   @map("completion_marked_by")
  attendancePercentage         Int       @default(0) @map("attendance_percentage")
  assignmentChecklistCompleted Boolean   @default(false) @map("assignment_checklist_completed")
  performanceSatisfactory      Boolean   @default(false) @map("performance_satisfactory")
  feedbackConsidered           Boolean   @default(false) @map("feedback_considered")
  certificateEligible          Boolean   @default(false) @map("certificate_eligible")
  upgradeFromEnrolmentId       String?   @map("upgrade_from_enrolment_id")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  tier Tier @relation(fields: [tierId], references: [id], onDelete: Restrict)

  programmes           EnrolmentProgramme[]
  attendanceRecords    AttendanceRecord[]
  assignmentChecklists AssignmentChecklist[]
  certificates         MemberCertificate[]
  // One-to-many, not one-to-one. D-8 reuses the same row for a resubmission, but
  // nothing forbids a second purchase intent against the same enrolment later, and
  // a `@unique` enrolmentId would make that impossible to record rather than
  // merely unusual. Activation reads the payment id, so it does not care.
  payments             Payment[]

  @@index([userId])
  @@index([tierId])
  @@map("enrolment")
}

model EnrolmentProgramme {
  enrolmentId          String @map("enrolment_id")
  programmeId          String @map("programme_id")
  attendanceThreshold  Int    @map("attendance_threshold") // Snapshotted from Programme
  // Cached per-programme percentage. PRD §12.3 measures attendance per programme,
  // so a member on two programmes must not be able to pool sessions across them to
  // clear one programme's threshold. Derived from AttendanceRecord, never truth.
  attendancePercentage Int    @default(0) @map("attendance_percentage")

  enrolment Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@id([enrolmentId, programmeId])
  @@map("enrolment_programme")
}

model AttendanceRecord {
  id          String   @id @default(cuid()) @map("id")
  userId      String   @map("user_id")
  sessionId   String   @map("session_id")
  enrolmentId String   @map("enrolment_id")
  status      String   @map("status") // present, absent, late, excused
  method      String   @map("method") // qr, manual, fallback_code
  markedBy    String?  @map("marked_by")
  markedAt    DateTime @default(now()) @map("marked_at")
  notes       String?  @map("notes")

  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  session   ProgrammeSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  enrolment Enrolment        @relation(fields: [enrolmentId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([sessionId])
  @@index([enrolmentId])
  // One manual attendance decision per member per session. Re-marking updates
  // the same record and preserves the latest actor/notes instead of inflating
  // the denominator with duplicate rows.
  @@unique([enrolmentId, sessionId])
  @@map("attendance_record")
}

model AssignmentChecklist {
  id              String    @id @default(cuid()) @map("id")
  enrolmentId     String    @map("enrolment_id")
  requirementName String    @map("requirement_name")
  isCompleted     Boolean   @default(false) @map("is_completed")
  completedAt     DateTime? @map("completed_at")
  markedBy        String?   @map("marked_by")
  notes           String?   @map("notes")

  enrolment Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  @@index([enrolmentId])
  @@map("assignment_checklist")
}

// ---------------------------------------------------------------------------
// Payment (D-8, D-9)
// ---------------------------------------------------------------------------
// PRD §16.4, manual verification only. There is no gateway: the member pays by
// bank transfer or mobile money, uploads proof, and an admin verifies it.
//
// `order_id` is deliberately absent. PRD §16.4 pairs a Payment with an Order,
// but D-10 sequences the Product/Order/Entitlement work behind this workflow
// and does not yet settle Order's own status vocabulary, so modelling a half
// Order now would add a dangling FK that has to be migrated later anyway. The
// column arrives with the Order model; the table is empty until then, so adding
// it later is a plain additive migration with no backfill (D-21).
//
// `payment_reference` and `proof_url` are nullable because a row in `pending`
// means "created, awaiting proof upload" (D-9). Making either required would make
// that state unrepresentable.
//
// There is no `channel`, `provider_reference`, or `provider_status`. Phase 2
// adds those in their own migration if a gateway is ever approved; speculative
// gateway columns rot.
enum PaymentStatus {
  pending // created, awaiting proof upload
  submitted // proof uploaded, sitting in the verification queue
  under_review // an admin has opened it
  verified // approved — activates the linked enrolment
  rejected // refused with a reason; the member may resubmit
}

model Payment {
  id               String        @id @default(cuid()) @map("id")
  userId           String        @map("user_id")
  enrolmentId      String?       @map("enrolment_id")
  amountKobo       Int           @map("amount_kobo")
  currency         String        @default("NGN") @map("currency")
  paymentMethod    String?       @map("payment_method")
  paymentReference String?       @map("payment_reference")
  bankName         String?       @map("bank_name")
  transferDate     DateTime?     @map("transfer_date")
  // Points at the encrypted-at-rest object, never at a readable path (SEC-004).
  proofUrl         String?       @map("proof_url")
  status           PaymentStatus @default(pending) @map("status")
  submittedAt      DateTime?     @map("submitted_at")
  openedBy         String?       @map("opened_by")
  underReviewedAt  DateTime?     @map("under_reviewed_at")
  verifiedAt       DateTime?     @map("verified_at")
  verifiedBy       String?       @map("verified_by")
  // Cleared only by a fresh successful verification, never by a resubmission:
  // the audit log is the history, and the row keeps its last rejection reason
  // so an admin picking it up can still see why it bounced (D-8).
  rejectionReason  String?       @map("rejection_reason")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  user           User       @relation("PaymentUser", fields: [userId], references: [id], onDelete: Restrict)
  // SetNull rather than Restrict: an enrolment that is cancelled must not take a
  // financial record with it. The payment outlives the enrolment it paid for.
  enrolment      Enrolment? @relation(fields: [enrolmentId], references: [id], onDelete: SetNull)
  openedByUser   User?      @relation("PaymentOpenedBy", fields: [openedBy], references: [id], onDelete: SetNull)
  verifiedByUser User?      @relation("PaymentVerifiedBy", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([enrolmentId])
  // PostgreSQL partial unique index in
  // 20260929150000_prevent_duplicate_pending_payments: one open purchase
  // intent per member; historical submitted/verified/rejected rows remain
  // unrestricted. Prisma cannot express a partial index in the schema DSL.
  @@map("payment")
}

// ---------------------------------------------------------------------------
// Material (D-6)
// ---------------------------------------------------------------------------
model Material {
  id          String   @id @default(cuid()) @map("id")
  programmeId String   @map("programme_id")
  title       String   @map("title")
  description String?  @map("description")
  fileUrl     String   @map("file_url")
  active      Boolean  @default(true) @map("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@index([programmeId])
  @@map("material")
}
