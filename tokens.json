    "type-tracking-display-large": "0em",
    "type-tracking-display-medium": "0em",
    "type-tracking-display-small": "0em",
    "type-tracking-headline-large": "0em",
    "type-tracking-headline-medium": "0em",
    "type-tracking-headline-small": "0em",
    "type-tracking-title-large": "0em",
    "type-tracking-title-medium": "0.009em",
    "type-tracking-title-small": "0.007em",
    "type-tracking-body-large": "0.031em",
