# Copy to `.env` and replace every value. Never commit the real file.
#
# `DATABASE_URL` uses 5432, which is correct for CI and for a machine with no
# local Postgres. If a native Postgres already owns 5432 (common on Windows
# dev boxes), the Docker container maps its 5432 to 5433 — change the port here
# to match rather than fighting the port.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ehems?schema=public"

# Same database, reached without a connection pooler. Prisma's schema engine holds
# a single persistent connection to read migration state, and a transaction-pooling
# proxy (PgBouncer, which Neon's `-pooler` endpoint uses) returns the connection
# after every transaction — so `prisma migrate` and `db push` fail against it.
# Production therefore needs both: `DATABASE_URL` pooled for runtime traffic, this
# one direct for the Prisma CLI. Where there is no pooler, they are identical.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/ehems?schema=public"

# --- Production database ----------------------------------------------------
#
# The two values above are for a local database. Production uses Neon, reached
# through the Vercel marketplace integration, and the two URLs differ there:
# DATABASE_URL points at the `-pooler` host and DATABASE_URL_UNPOOLED at the
# plain host. Do not point both at the pooled host, and do not swap them.
#
# Set them as repository secrets for `.github/workflows/migrate-production.yml`:
#   Settings -> Secrets and variables -> Actions -> New repository secret
#     DATABASE_URL          (the pooled URL)
#     DATABASE_URL_UNPOOLED (the direct URL)
#
# The same two names already exist as Vercel project variables, set
# automatically by the Neon integration. `vercel env pull` returns those with
# real values, but returns an EMPTY value for any variable marked sensitive
# (as AUTH_SESSION_SECRET is), so a pulled file is not a usable substitute for
# the real secret.

# 32+ random bytes for signing session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET="local-development-secret-not-for-production-0000000000"

APP_BASE_URL="http://localhost:3000"

# --- Payment proof storage (SEC-004) ----------------------------------------
#
# Which backend holds encrypted payment proofs: `local` or `blob`. Default
# `local`, which is what dev, CI, and the Playwright suite use.
#
# PRODUCTION MUST BE `blob`. A Vercel function's filesystem does not survive a
# redeploy, so with `local` the ciphertext is discarded while `Payment.proofUrl`
# keeps pointing at it — the member's financial evidence is then unreadable and
# the payment can never be verified. `proofStore` in `lib/payments/proofs.ts`
# throws rather than allowing this, so a missed setting fails loudly at the first
# upload instead of silently.
#
# Setup for `blob`: Vercel dashboard -> Storage -> Create Blob -> access
# **Private** -> connect the store to the project. Authentication is then handled
# by a short-lived, auto-rotating Vercel OIDC token, so there is no
# BLOB_READ_WRITE_TOKEN to create, store, or rotate. Do not commit one.
PAYMENT_PROOF_STORE="local"

# Escape hatch that permits PAYMENT_PROOF_STORE=local in a `next start` build.
#
# Leave it unset in every real environment. It exists because "production" and
# "a real deployment" are not the same thing: `next start` sets NODE_ENV=production,
# and the Playwright suite serves a real build that has to write a real proof.
#
# Setting it means accepting that proofs are lost when the process is replaced.
# Never set it on a deployed host.
PAYMENT_PROOF_ALLOW_EPHEMERAL_STORE=""

# AES-256-GCM key for payment proof files. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Losing this key makes every stored proof permanently unreadable, and reusing a
# key across environments is a production incident. Staging and production each
# need their own, held in the platform's secret store — not in a committed file
# and not in the repository history.
#
# This encrypts the payload regardless of which backend is selected, so switching
# stores cannot weaken SEC-004 — but it also means switching the key makes every
# proof already in the store unreadable. Rotate by migrating objects, never in
# place.
PAYMENT_PROOF_ENCRYPTION_KEY=""

# Where the `local` driver's encrypted proofs live. Default `.storage/proof`
# inside the project directory, which is gitignored.
#
# LOCAL DEVELOPMENT ONLY. Ignored when PAYMENT_PROOF_STORE=blob. Do not point it
# at a mounted volume hoping to serve production: a container volume is still
# discarded on redeploy, which is the exact failure `blob` exists to prevent.
PAYMENT_PROOF_STORAGE_DIR=""
